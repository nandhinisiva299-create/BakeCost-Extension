{
  "manifest_version": 3,
  "name": "BakeCost — Smart Bakery Costing & Pricing Assistant",
  "short_name": "BakeCost",
  "version": "1.0.0",
  "description": "Smart recipe costing, utility overheads, packaging, baker wages & profit pricing calculator for home bakers and small baking businesses.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BakeCost — Bakery Costing Assistant",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
